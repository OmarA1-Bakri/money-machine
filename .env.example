# development | test | production. Development and test force simulation-only authority; an empty or unknown value is an error.
APP_ENV=development
POSTGRES_DB=money_machine
POSTGRES_USER=money_machine
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql+asyncpg://money_machine:local_development_only@postgres:5432/money_machine
# The application reads MONEY_MACHINE_DATABASE_URL first, then DATABASE_URL. A password may
# be embedded in the URL or supplied separately as MONEY_MACHINE_DATABASE_PASSWORD; either
# way it is held as a redacted secret and never logged. Production requires this to be set.
MONEY_MACHINE_DATABASE_URL=
MONEY_MACHINE_DATABASE_PASSWORD=
# Maintenance connection used only by database-backed tests to create throwaway databases.
MONEY_MACHINE_TEST_ADMIN_DATABASE_URL=
API_AUTH_TOKEN=
POSTHOG_API_KEY=
# Provider credentials. Presence alone never grants authority: development and test force
# simulation, and a live effect mode additionally requires standing authority in
# config/autonomy.yaml. Names only here, never values.
LLM_API_KEY=
ETSY_API_KEY=
NOTION_API_KEY=
COMPOSIO_API_KEY=
POSTHOG_API_KEY=
# Compose host port mappings. Change these when a port is already in use locally.
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
